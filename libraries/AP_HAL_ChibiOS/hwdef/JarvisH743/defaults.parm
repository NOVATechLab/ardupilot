SCR_ENABLE 1

# Rover control via Lua scripting
# SERVO1 (PA0) throttle output, MOT_PWM_TYPE=4 (Brushed Bi-Polar), MOT_PWM_FREQ=1000
SERVO1_FUNCTION 70
SERVO1_MIN 1000
SERVO1_MAX 2000
SERVO1_TRIM 1000

# Enable all 7 relay channels
RELAY1_FUNCTION 1
RELAY2_FUNCTION 1
RELAY3_FUNCTION 1
RELAY4_FUNCTION 1
RELAY5_FUNCTION 1
RELAY6_FUNCTION 1
RELAY7_FUNCTION 1
RELAY8_FUNCTION 1
