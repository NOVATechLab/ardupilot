SCR_ENABLE 1

# RC channel mapping: CH1=throttle (vertical stick), CH2=steering (horizontal stick)
# Default is RCMAP_THROTTLE=3, RCMAP_ROLL=1 — must override for spring-centered joystick
RCMAP_THROTTLE 1
RCMAP_ROLL 2

# Rover control via Lua scripting
# SERVO1 (PA0) throttle output, MOT_PWM_TYPE=4 (Brushed Bi-Polar), MOT_PWM_FREQ=1000
SERVO1_FUNCTION 70
SERVO1_MIN 800
SERVO1_MAX 2000
SERVO1_TRIM 1000
# SERVO2 dummy steering — satisfies prearm check, not physically connected
SERVO2_FUNCTION 26

# Enable all 16 relay channels (V2: 8 GPIO relays + 8 ex-PWM pins as GPIO)
RELAY1_FUNCTION 1
RELAY2_FUNCTION 1
RELAY3_FUNCTION 1
RELAY4_FUNCTION 1
RELAY5_FUNCTION 1
RELAY6_FUNCTION 1
RELAY7_FUNCTION 1
RELAY8_FUNCTION 1
RELAY9_FUNCTION 1
RELAY10_FUNCTION 1
RELAY11_FUNCTION 1
RELAY12_FUNCTION 1
RELAY13_FUNCTION 1
RELAY14_FUNCTION 1
RELAY15_FUNCTION 1
RELAY16_FUNCTION 1

# Relay board is active-LOW (driver inverts): energised = pin LOW.
# Without this the relays sit ON at boot / logic is inverted.
RELAY1_INVERTED 1
RELAY2_INVERTED 1
RELAY3_INVERTED 1
RELAY4_INVERTED 1
RELAY5_INVERTED 1
RELAY6_INVERTED 1
RELAY7_INVERTED 1
RELAY8_INVERTED 1
RELAY9_INVERTED 1
RELAY10_INVERTED 1
RELAY11_INVERTED 1
RELAY12_INVERTED 1
RELAY13_INVERTED 1
RELAY14_INVERTED 1
RELAY15_INVERTED 1
RELAY16_INVERTED 1
