# ====================================================================
# JarvisH743 - default parameters 
# ====================================================================

# --- Scripting (existing, keep enabled for board lua scripts) ---
SCR_ENABLE 1

# --- Frame / mounting ---
FRAME_CLASS 1
FRAME_TYPE 0
AHRS_ORIENTATION 2

# --- Arming / compass (intentionally relaxed for this vehicle) ---
ARMING_CHECK 0
COMPASS_ENABLE 0

# --- Steering setup (skid steering) ---
SERVO1_FUNCTION 74
SERVO2_FUNCTION 73
MANUAL_OPTIONS 0
MANUAL_STR_EXPO 0
MANUAL_STR_SLEW 50

# --- Speed / navigation config ---
CRUISE_SPEED 2
CRUISE_THROTTLE 50
SPEED_MAX 0
TURN_RADIUS 0.9
WP_SPEED 2
WP_RADIUS 2
WP_PIVOT_ANGLE 60
WP_PIVOT_RATE 60
RTL_SPEED 0
LOIT_RADIUS 2
LOIT_SPEED_GAIN 0.5
ACRO_TURN_RATE 180

# --- Steering controller tuning ---
ATC_STR_ANG_P 2
ATC_STR_ACC_MAX 120
ATC_STR_RAT_MAX 120
ATC_STR_RAT_P 0.2
ATC_STR_RAT_I 0.2
ATC_STR_RAT_FF 0.2
ATC_STR_RAT_IMAX 1
ATC_STR_RAT_FLTE 10

# --- Speed/throttle controller tuning ---
ATC_SPEED_P 0.2
ATC_SPEED_I 0.2
ATC_SPEED_IMAX 1
ATC_SPEED_FLTE 10
ATC_ACCEL_MAX 1
ATC_BRAKE 1
ATC_STOP_SPEED 0.1
ATC_TURN_MAX_G 0.6

# --- Position controller tuning ---
PSC_POS_P 0.2
PSC_VEL_P 1
PSC_VEL_FLTD 5
PSC_VEL_FLTE 5

# --- Motor output config ---
MOT_PWM_FREQ 16
MOT_PWM_TYPE 0
MOT_SLEWRATE 100
MOT_STR_THR_MIX 0.5
MOT_THR_MAX 100
MOT_THR_MIN 0
MOT_THST_ASYM 1

# --- DroneCAN / ESC over CAN ---
CAN_P1_DRIVER 1
CAN_P1_BITRATE 500000
CAN_P1_FDBITRATE 4
CAN_D1_PROTOCOL 1
CAN_D1_UC_NODE 10
CAN_D1_UC_ESC_BM 3
CAN_D1_UC_ESC_RV 7
CAN_D1_UC_SRV_BM 3072
CAN_P2_DRIVER 2
CAN_P2_BITRATE 500000
CAN_D2_PROTOCOL 1

# --- Battery monitors ---
BATT_MONITOR 9
BATT_CAPACITY 3300
BATT_OPTIONS 128
BATT_LOW_TIMER 10
BATT2_MONITOR 9
BATT2_CAPACITY 3300
BATT2_SERIAL_NUM 1

# --- EKF3 source set (this vehicle runs without compass) ---
EK3_SRC_OPTIONS 1
EK3_SRC1_POSXY 3
EK3_SRC1_POSZ 1
EK3_SRC1_VELXY 3
EK3_SRC1_VELZ 3
EK3_SRC1_YAW 1

# --- Failsafe ---
FS_ACTION 2
FS_TIMEOUT 1.5
FS_THR_ENABLE 1
FS_THR_VALUE 910
FS_EKF_ACTION 1
FS_EKF_THRESH 0.8
FS_CRASH_CHECK 0
FS_GCS_ENABLE 0
FS_GCS_TIMEOUT 5

# --- Geofence ---
FENCE_ENABLE 0
FENCE_ACTION 1
FENCE_TYPE 6
FENCE_RADIUS 300
FENCE_MARGIN 2

# --- Object avoidance ---
AVOID_ENABLE 3
AVOID_BEHAVE 1
AVOID_MARGIN 2
AVOID_ACCEL_MAX 3
AVOID_BACKUP_SPD 0.75

# --- Flight mode selection ---
MODE_CH 8
INITIAL_MODE 0

# --- RC config ---
RC_PROTOCOLS 1
RC_OPTIONS 32
RC_OVERRIDE_TIME 3
RC1_DZ 30
RC3_DZ 30
RC4_DZ 30
RC5_OPTION 153

# --- Notifications / LED / buzzer ---
NTF_LED_TYPES 123079
NTF_LED_BRIGHT 3
NTF_BUZZ_TYPES 5

# --- Logging ---
LOG_BITMASK 65535

# --- NOVA custom parameters ---
NOVA_LEDLIGHT_ 0
NOVA_LEDLIGHT_C 1
NOVA_MINE_ 0
NOVA_MINE_C1 1
NOVA_MINE_C2 1
NOVA_MINE_C3 1
NOVA_MINE_C4 1
NOVA_MINE_T1 1
NOVA_MINE_T2 1
NOVA_MINE_T3 1
NOVA_MINE_T4 1
NOVA_NLIGHT_ 0
NOVA_NLIGHT_C 1
NOVA_REB_ 0
NOVA_REB_C1 1
NOVA_REB_C2 1
NOVA_REB_C3 1
NOVA_REB_C4 1
NOVA_REB_C5 1
NOVA_REB_C6 1
NOVA_REB_C7 1
NOVA_REB_C8 1
NOVA_REB_T1 0
NOVA_REB_T2 0
NOVA_REB_T3 0
NOVA_REB_T4 0
NOVA_REB_T5 0
NOVA_REB_T6 0
NOVA_REB_T7 0
NOVA_REB_T8 0
NOVA_UNIVERSAL_ 0
NOVA_UNIVERSAL_C 1
NOVA_YAGOZA_ 0
NOVA_YAGOZA_C1 1
NOVA_YAGOZA_C2 1
NOVA_YAGOZA_T1 1
NOVA_YAGOZA_T2 1
